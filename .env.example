# ContaComigo — variáveis de ambiente.
#
# Copie para .env e preencha. O .env NUNCA é versionado (.gitignore + o gate
# de staging bloqueiam). Este arquivo de exemplo é a documentação oficial das
# variáveis: valor de exemplo e valor obrigatório ficam separados.

# --- Banco local (docker-compose.yml) -------------------------------------
# Valor de exemplo: funciona com o compose deste repositório, sem alteração.
DATABASE_URL="postgresql://contacomigo:contacomigo_dev_local@localhost:5433/contacomigo"

# --- Segredos (obrigatórios, sem valor de exemplo) ------------------------
# Segredo do access token (ADR-004). OBRIGATÓRIO desde HN-001: sem ele a API
# recusa emitir token, em vez de assinar com um valor padrão — um segredo padrão
# é o mesmo que nenhum. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Não há segredo de refresh: o refresh é opaco e aleatório, e o banco guarda
# apenas o hash dele (ADR-004, revogação real).

# Chave da cifra em repouso (ADR-002, RNF-014): 32 bytes em hex (64 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sem ela o utilitario de cifra RECUSA operar em vez de gravar texto claro.
ENCRYPTION_KEY=""

# --- Integrações externas (a partir de HT-011 e HT-013) -------------------
PLUGGY_CLIENT_ID=""
PLUGGY_CLIENT_SECRET=""
GEMINI_API_KEY=""
