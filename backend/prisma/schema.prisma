// Persistence model (ADR-002, rule 1). NOT the domain entity: the repository in
// infrastructure/persistence/ translates between the two. The generated client
// lives inside persistence/ — the only place that knows it.

generator client {
  provider = "prisma-client"
  output   = "../src/transactions/infrastructure/persistence/gerado"
}

datasource db {
  provider = "postgresql"
}

model Transaction {
  id            String   @id
  holderId      String   @map("titular_id")
  description   String   @map("descricao")
  amountInCents Int      @map("valor_em_centavos")
  dueDate       DateTime @map("data_de_competencia") @db.Timestamptz(3)
  externalId    String?  @map("identificador_externo")

  @@index([holderId])
  @@index([holderId, externalId])
  @@map("lancamentos")
}

// External account as persisted for the consolidated panel (HN-003). The type
// separates active accounts (checking/savings) from credit cards: the card
// enters the panel as a bill, never summed into the balance (RN-009).
model ExternalAccount {
  id               String @id
  holderId         String @map("titular_id")
  externalId       String @map("identificador_externo")
  institutionId    String @map("institution_id")
  type             String @map("tipo")
  balanceInCents   Int    @map("saldo_em_centavos")

  @@index([holderId])
  @@map("contas_externas")
}

// Access context (HN-001). The account IS the holder: there is no separate user
// table. Stores the password hash, never the password.
model Account {
  id           String   @id
  email        String   @unique
  name         String   @default("")
  passwordHash String   @map("hash_da_senha")
  createdAt    DateTime @default(now()) @map("criada_em") @db.Timestamptz(3)

  @@map("contas")
}

// Refresh token: the database stores its HASH. If it leaks, the refreshes are
// unusable (ADR-004, real revocation).
model Session {
  id               String    @id
  holderId         String    @map("titular_id")
  refreshTokenHash String    @unique @map("hash_do_refresh")
  expiresAt        DateTime  @map("expira_em") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revogado_em") @db.Timestamptz(3)

  @@index([holderId])
  @@map("sessoes")
}

// Consent as a first-class record (HN-002). The explicit decision of a person
// to authorize an institution. The aggregator credential is stored CIPHERED
// (RNF-014); the domain never sees the plain value.
model Consent {
  id                String    @id
  holderId          String    @map("titular_id")
  institutionId     String    @map("institution_id")
  connectionId      String    @map("connection_id")
  scope             String
  credentialCipher  String    @map("credential_cipher")
  createdAt         DateTime  @default(now()) @map("criado_em") @db.Timestamptz(3)
  expiresAt         DateTime  @map("expira_em") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revogado_em") @db.Timestamptz(3)
  deletionScheduledAt DateTime? @map("exclusao_agendada_em") @db.Timestamptz(3)
  lastSyncAt        DateTime? @map("ultima_sincronizacao_em") @db.Timestamptz(3)

  @@index([holderId])
  @@map("consents")
}