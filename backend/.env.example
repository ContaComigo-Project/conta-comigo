# Copie para backend/.env e preencha (backend/.env é ignorado pelo git).
# A credencial do Postgres local é a do docker-compose (dev, sem valor fora da máquina).

# Banco local (docker compose) — já é o fallback da aplicação; documentado aqui.
DATABASE_URL="postgresql://contacomigo:contacomigo_dev_local@localhost:5433/contacomigo"

# Autenticação (HN-001). Obrigatório; sem ele a API recusa iniciar.
JWT_SECRET=segredo-local-de-dev

# Cifra em repouso (HT-010/RNF-014). 64 caracteres hex (dev: 64×"a").
ENCRYPTION_KEY=

# IA educativa (HT-013). Sem a chave, o adaptador falso assume (determinístico).
GEMINI_API_KEY=
GEMINI_MODEL=

# Teto diário de chamadas de IA por titular (RNF-009). Padrão: 20.
AI_DAILY_LIMIT=

# Agregador Pluggy Sandbox (HT-011) — opcional; o falso assume sem chave.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=