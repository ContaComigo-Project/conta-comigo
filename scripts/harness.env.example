# Harness — registro de comandos do projeto.
#
# Copie para scripts/harness.env e preencha ao concluir a história HT-005.
# Regra: o mesmo comando roda localmente e no CI. Se divergirem, o CI mente.
#
# Deixe vazio o que ainda não existe: o harness falha de forma explícita
# ("comando não configurado") em vez de fingir sucesso.

# Prepara o ambiente em máquina limpa (instala dependências, sobe serviços).
HARNESS_SETUP=""

# Derruba e limpa o ambiente local.
HARNESS_DOWN=""

# Compila / empacota.
HARNESS_BUILD=""

# Análise estática e formatação.
HARNESS_LINT=""

# Testes funcionais / BDD. Rodam ANTES do código produtivo existir.
HARNESS_TEST_FUNCTIONAL=""

# Testes unitários. Rodam depois do verde funcional.
HARNESS_TEST_UNIT=""

# Suíte completa.
HARNESS_TEST=""

# Relatório de cobertura.
HARNESS_COVERAGE=""

# Verificação de segurança (dependências, segredos, análise).
HARNESS_SECURITY=""

# Executa a aplicação localmente.
HARNESS_RUN=""
